{
  "name": "lastro-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "start": "node dist/src/app/server.js",
    "build": "node --import tsx scripts/check-runtime.ts && tsc -p tsconfig.build.json && node scripts/package-assets.mjs && node scripts/check-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "node scripts/emulators.mjs test",
    "emulators": "node scripts/emulators.mjs start",
    "seed:local": "tsx scripts/seed-local.ts",
    "migrate:plans": "tsx src/jobs/migratePlans.ts",
    "job:billing": "node dist/src/jobs/billingCycle.js",
    "openapi": "tsx scripts/export-openapi.ts",
    "types:api": "openapi-typescript docs/api/openapi.json -o docs/api/generated-types.ts",
    "audit:dependencies": "npm audit --omit=dev",
    "audit:secrets": "node scripts/check-secrets.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "check:openapi": "tsx scripts/check-openapi.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "fontkit": "^2.0.4",
    "helmet": "^8.3.0",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "firebase-tools": "^15.33.0",
    "openapi-typescript": "^7.13.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "chokidar": "^4.0.3",
    "basic-ftp": "^6.2.2",
    "@google-cloud/pubsub": "^6.2.0",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "re2": "^1.27.0"
  }
}
