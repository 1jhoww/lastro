# Local demo only. Never combine emulator environment with real project credentials.
NODE_ENV=development
PORT=3000
FIREBASE_MODE=emulator
FIREBASE_PROJECT_ID=demo-lastro-phase-a
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Emulator bucket is derived from project ID; production may supply an existing bucket.
# STORAGE_BUCKET=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY_HOPS=0
# Hops-based trust is rejected. Production accepts explicit, verified peer IPs/CIDRs only.
# TRUST_PROXY_ADDRESSES=10.20.30.40/32
# Cloud Run ingress must prevent bypass and sanitize forwarded headers before enabling trust.
RATE_LIMIT_MAX=180
# Local mode automatically generates an ignored key in .local/invitation.key.
# Production requires a supplied secret >=43 chars from Secret Manager and HTTPS.
# INVITATION_SECRET=
# PUBLIC_ORIGIN=https://api.example.invalid
