{"nodes": [{"id": "backend_docs_f02_delivery", "label": "F02 Delivery Report", "file_type": "document", "source_file": "backend/docs/f02-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_docs_f02_delivery_resumable_financial_resolution", "label": "F02 Resumable Financial Resolution Executor", "file_type": "concept", "source_file": "backend/docs/f02-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancellation/return of orders with very many payments cannot fit one Firestore transaction, so a durable, resumable executor applies bounded batches and publishes one final financial state; no new commercial limit is imposed."}, {"id": "backend_docs_f02_delivery_sealed_proof_merkle", "label": "Sealed Proof Entries with Incremental Merkle", "file_type": "rationale", "source_file": "backend/docs/f02-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutable proof entries with exact-body backup and a bounded-frontier Merkle build avoid whole-history arrays; missing entries are recovered only from the verifiable sealed body, altered bodies are never overwritten."}, {"id": "backend_docs_f02_delivery_execution_fence_lease", "label": "Execution Lease and Fence", "file_type": "concept", "source_file": "backend/docs/f02-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin resume re-authenticates and takes a new fence; an expired lease never releases money, order or batch. Sealed fence identifies proof, current fence guards the executor."}, {"id": "backend_docs_f02_delivery_financial_resumable_required", "label": "409 FINANCIAL_RESUMABLE_REQUIRED", "file_type": "concept", "source_file": "backend/docs/f02-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More than 100 payments/applications must use the resumable path before history is loaded; the old atomic path stays 200 for small histories."}, {"id": "backend_docs_f02_delivery_20000_source_capacity_fixtures", "label": "20,000-Source Capacity Fixtures", "file_type": "concept", "source_file": "backend/docs/f02-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct-seeded fixtures prove structural completability of cancellation and return with 20,000 sources, but do not replace 20,000 real HTTP receipts or certify production performance/cost."}, {"id": "backend_docs_f02_delivery_batch_budget_limits", "label": "F02 Batch Budget Limits (150 reads, 100 writes)", "file_type": "concept", "source_file": "backend/docs/f02-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "backend_docs_f02_delivery", "target": "backend_docs_f02_delivery_resumable_financial_resolution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/docs/f02-delivery.md", "source_location": null, "weight": 1.0}, {"source": "backend_docs_f02_delivery_resumable_financial_resolution", "target": "backend_docs_f02_delivery_sealed_proof_merkle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/docs/f02-delivery.md", "source_location": null, "weight": 1.0}, {"source": "backend_docs_f02_delivery_resumable_financial_resolution", "target": "backend_docs_f02_delivery_execution_fence_lease", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/docs/f02-delivery.md", "source_location": null, "weight": 1.0}, {"source": "backend_docs_f02_delivery_resumable_financial_resolution", "target": "backend_d