{"nodes": [{"id": "backend_docs_operations_f03_f07", "label": "Operacao tecnica F03-F07", "file_type": "document", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_docs_operations_f03_f07_http_rate_limiter", "label": "Cheap Per-IP HTTP Limiter Before JSON/Auth", "file_type": "concept", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Limiter precedes express.json, auth and SDK so invalid/oversized/valid requests all consume the same quota; key cardinality capped at 10,000 per instance."}, {"id": "backend_docs_operations_f03_f07_trust_proxy_policy", "label": "Trust Proxy Policy (TRUST_PROXY_HOPS=0)", "file_type": "rationale", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hop-count trust is rejected; only explicit IPs/CIDRs are trusted, and only after Cloud Run ingress topology is validated, to prevent X-Forwarded-For spoofing of rate-limit keys."}, {"id": "backend_docs_operations_f03_f07_readiness_probe", "label": "Health Ready/Live Probes with Coalesced Firestore Read", "file_type": "concept", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_docs_operations_f03_f07_retention_ttl_policy", "label": "Retention and TTL Policy", "file_type": "concept", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TTL declared only for rateLimits (not deployed); administrative idempotency records are never TTL'd because deleting the key would reopen replay; financial ledger/proofs/audit retention is untouched."}, {"id": "backend_docs_operations_f03_f07_image_cleanup_jobs", "label": "Durable Image Cleanup Jobs", "file_type": "concept", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upload candidate is persisted before Storage; retired images get a 24h grace job; uploading jobs are not reclaimed by age because an in-flight RPC may still complete."}, {"id": "backend_docs_operations_f03_f07_timeout_concurrency_limits", "label": "Read/Document Timeouts and Concurrency Slots", "file_type": "concept", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hung SDK RPCs keep their slot until completion rather than freeing capacity for more hung RPCs; 503 REQUEST_OUTCOME_UNKNOWN on command timeout with idempotent retry; reads capped by a 32 MiB memory budget."}, {"id": "backend_docs_operations_f03_f07_node_runtime_pinning", "label": "Node 22.23.3 Runtime Pinning and Build Smoke Test", "file_type": "concept", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_docs_operations_f03_f07_openapi_generation", "label": "OpenAPI 0.8.1 Generation (input/output schemas)", "file_type": "concept", "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "backend_docs_operations_f03_f07", "target": "backend_docs_operations_f03_f07_http_rate_limiter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/docs/operations-f03-f07.md", "source_location": null, "weight": 1.0}, {"source": "backend_docs_operations_f03_f07_http_rate_limiter", "target": "